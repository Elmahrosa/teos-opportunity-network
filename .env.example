# TEOS Opportunity Network — environment template.
# Copy to .env (git-ignored) and fill in real values. NEVER commit real secrets.

# Telegram (required for real sends; tests use fakes and never need this)
TELEGRAM_BOT_TOKEN=<bot-token-from-botfather>
TELEGRAM_CHAT_ID=<your-chat-id>

# GitHub (optional; Bearer auth for api.github.com/search/issues)
GITHUB_TOKEN=<github-token>

# Semantic evaluation (optional; matcher falls back to neutral-50 without it)
# Legacy single-provider: OPENAI_API_KEY=<openai-key>
OPENAI_API_KEY=

# Free-LLM semantic ensemble (multi-agent: several free models, deterministic median fusion)
# All optional — no providers configured (or every provider failing) → neutral-50, never a crash.
# TEOS_LLM_PROVIDERS=groq,openrouter          # comma-separated list of agents to run
# GROQ_API_KEY=<free-key>                     # console.groq.com (default model llama-3.3-70b-versatile)
# OPENROUTER_API_KEY=<free-key>               # openrouter.ai (default: meta-llama/llama-3.3-70b-instruct:free)
# GEMINI_API_KEY=<free-key>                   # aistudio.google.com (default model gemini-2.0-flash)
# MISTRAL_API_KEY=<free-key>                  # console.mistral.ai (default model open-mistral-7b)
# GITHUB_API_KEY=<github-pat-with-models-access>  # models.github.ai (default model gpt-4o-mini)
# OLLAMA_BASE_URL=http://localhost:11434/v1   # keyless local server (default model qwen2.5:7b)
# <NAME>_MODEL=<model-id>                     # optional per-provider override
# Groq/OpenRouter base overrides (rarely needed): GROQ_BASE_URL, OPENROUTER_BASE_URL

# Application database (PostgreSQL — authoritative)
DATABASE_URL=Host=localhost;Port=54329;Username=teos;Password=<password>;Database=teos

# Test database (dotnet test). Defaults to the local Docker test container.
TEOS_TEST_DB=Host=localhost;Port=54329;Username=teos;Password=teos_test;Database=postgres

# Notification runtime (--loop) — interval in seconds (default 300)
TEOS_LOOP_SECONDS=300

# Confidence stored with each match result (default 0.9)
TEOS_CONFIDENCE=0.9
