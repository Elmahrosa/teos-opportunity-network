# TEOS Opportunity Network — environment template.
# Copy to .env (git-ignored) and fill in real values. NEVER commit real secrets.

# Telegram (required for real sends; tests use fakes and never need this)
TELEGRAM_BOT_TOKEN=<bot-token-from-botfather>
TELEGRAM_CHAT_ID=<your-chat-id>

# GitHub (optional; Bearer auth for api.github.com/search/issues)
GITHUB_TOKEN=<github-token>

# Semantic evaluation (optional; matcher falls back to neutral without it)
OPENAI_API_KEY=<openai-key>

# Application database (PostgreSQL — authoritative)
DATABASE_URL=Host=localhost;Port=54329;Username=teos;Password=<password>;Database=teos

# Test database (dotnet test). Defaults to the local Docker test container.
TEOS_TEST_DB=Host=localhost;Port=54329;Username=teos;Password=teos_test;Database=postgres
