{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/disk", "destination": "/disk" }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "domains": ["teoson.elmahrosa.org"]
}
